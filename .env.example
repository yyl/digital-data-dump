# =============================================================================
# Letterboxd Configuration
# =============================================================================
LETTERBOXD_RSS_URL=https://letterboxd.com/longyu/rss/
TMDB_ACCESS_TOKEN=your_tmdb_access_token_here
TMDB_API_KEY=your_tmdb_api_key_here

# =============================================================================
# Readwise Configuration
# =============================================================================
# Get your token from: https://readwise.io/access_token
READWISE_ACCESS_TOKEN=your_readwise_token_here

# =============================================================================
# Foursquare Configuration
# =============================================================================
# Create an app at: https://foursquare.com/developers/apps
FOURSQUARE_CLIENT_ID=your_client_id_here
FOURSQUARE_CLIENT_SECRET=your_client_secret_here

# Service API key for Places API (v3)
FOURSQUARE_API_KEY=your_api_key_here

# OAuth access token (auto-populated after first auth)
# FOURSQUARE_ACCESS_TOKEN=

# =============================================================================
# Hardcover Configuration
# =============================================================================
# Get your token from: https://hardcover.app/account/api
HARDCOVER_ACCESS_TOKEN=your_hardcover_token_here

# =============================================================================
# Overcast Configuration
# =============================================================================
# Optional: direct OPML export without a manual file download.
# Prefer OVERCAST_COOKIE if you already have the "o" cookie from an authenticated
# session, otherwise set OVERCAST_EMAIL and OVERCAST_PASSWORD.
# OVERCAST_COOKIE=your_overcast_cookie_here
# OVERCAST_EMAIL=you@example.com
# OVERCAST_PASSWORD=your_overcast_password_here

# =============================================================================
# Oura Ring Configuration
# =============================================================================
# Register an app at: https://cloud.ouraring.com/oauth/applications
OURA_CLIENT_ID=your_client_id_here
OURA_CLIENT_SECRET=your_client_secret_here
OURA_REDIRECT_URI=https://localhost:8888/callback
# OAuth tokens (auto-populated after first auth)
# OURA_ACCESS_TOKEN=
# OURA_REFRESH_TOKEN=

# =============================================================================
# GitHub Activity Configuration
# =============================================================================
# Your GitHub username (for tracking public repo commits)
GITHUB_USERNAME=your_github_username_here

# =============================================================================
# GitHub Configuration (for publishing)
# =============================================================================
# Optional: override where local runs read/write data and imported files.
# Defaults to ../digital-data-vault when that sibling repo exists.
# DATA_REPO_LOCAL_PATH=../digital-data-vault

# Personal access token with repo write access
BLOG_GITHUB_TOKEN=your_github_token_here

# Repository settings
BLOG_REPO_OWNER=your_username_here
BLOG_REPO_NAME=your_blog_repo_here
BLOG_GITHUB_TARGET_BRANCH=main

# Optional: public Hugo JSON export used for blog post tracking
BLOG_POSTS_INDEX_URL=https://www.mildlyjournaling.com/posts/index.json

# =============================================================================
# Cloud Deployment (GitHub Actions)
# =============================================================================
# Private repository for storing data files (optional, for cloud automation)
# DATA_REPO_OWNER=your_username_here
# DATA_REPO_NAME=digital-data-vault

# =============================================================================
# Charles Schwab Configuration
# =============================================================================
# Register an app at: https://developer.schwab.com
SCHWAB_CLIENT_ID=your_client_id_here
SCHWAB_CLIENT_SECRET=your_client_secret_here
SCHWAB_CALLBACK_URL=https://127.0.0.1
# OAuth tokens (auto-populated after first auth)
# SCHWAB_ACCESS_TOKEN=
# SCHWAB_REFRESH_TOKEN=
